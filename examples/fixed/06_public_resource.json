{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": "*",
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::my-company-data/*",
        "Condition": {
          "StringEquals": {
            "aws:SourceVpc": "vpc-0a1b2c3d4e5f"
          }
        }
      }
    ]
  }