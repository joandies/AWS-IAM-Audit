{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "ec2:DescribeInstances"
        ],
        "Resource": [
          "arn:aws:s3:::my-app-bucket/*",
          "arn:aws:ec2:eu-west-1:123456789012:instance/*"
        ]
      }
    ]
  }